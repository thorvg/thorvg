source_file = [
   'tvgTvgLoader.h',
   'tvgModel.h',
   'tvgResource.h',
   'tvgTextParser.h',
   'tvgUtil.h',
   'tvgTvgLoader.cpp',
   'tvgModel.cpp',
   'tvgResource.cpp',
   'tvgTextParser.cpp',
   'tvgUtil.cpp'
]

submodule_dep += [declare_dependency(
    include_directories : include_directories('.'),
    sources : source_file
)]
