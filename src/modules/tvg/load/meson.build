source_file = [
   'tvgTvgBuilder.h',
   'tvgTvgLoader.h',
   'tvgTvgModel.h',
   'tvgTvgParser.h',
    'tvgTvgUtil.h',
   'tvgTvgBuilder.cpp',
   'tvgTvgLoader.cpp',
   'tvgTvgModel.cpp',
   'tvgTvgParser.cpp',
   'tvgTvgUtil.cpp'
]

submodule_dep += [declare_dependency(
