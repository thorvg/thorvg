#------------------------------------------------------------------------------
# wgpu-native GL/GLES backend
#
# wgpu-native keeps several internal backend caches and global state alive until
# process termination. Valgrind reports these allocations as "possibly lost",
# although they are owned by wgpu-native rather than ThorVG. Suppress only these
# known internal allocation paths so that genuine leaks in ThorVG remain visible.
#------------------------------------------------------------------------------

{
   wgpu-native-gles-egl-instance-cache
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*hashbrown*RawTableInner*fallible_with_capacity*
   fun:*hashbrown*RawTable*reserve_rehash*
   ...
   fun:*wgpu_hal*gles*egl*Instance*init*
   fun:*wgpu_core*instance*Instance*new*
   fun:*wgpu_core*global*Global*new*
   fun:wgpuCreateInstance
}

{
   wgpu-native-gles-glsl-writer-cache
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*hashbrown*RawTableInner*fallible_with_capacity*
   fun:*hashbrown*RawTable*reserve_rehash*
   ...
   fun:*core*ops*function*FnOnce*call_once*
   ...
   fun:*naga*back*glsl*writer*Writer*new*
   ...
   fun:*wgpu_core*indirect_validation*IndirectValidation*new*
}

#------------------------------------------------------------------------------
# Mesa llvmpipe worker teardown
#
# Mesa may access synchronization state after freeing it while an llvmpipe
# worker exits. Suppress only the observed 4-byte condition-variable and mutex
# accesses whose next frames are entirely inside libgallium.
#------------------------------------------------------------------------------

{
   mesa-llvmpipe-worker-cond-teardown
   Memcheck:Addr4
   fun:pthread_cond_broadcast*
   obj:*libgallium*.so*
   obj:*libgallium*.so*
   ...
}

{
   mesa-llvmpipe-worker-mutex-teardown
   Memcheck:Addr4
   fun:*mutex_unlock*
   ...
   obj:*libgallium*.so*
   obj:*libgallium*.so*
   ...
}
